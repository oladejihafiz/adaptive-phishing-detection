
{
  "manifest_version": 3,
  "name": "Adaptive Phishing Detector",
  "version": "1.0.0",
  "description": "Machine-learning phishing detection browser extension.",
  "permissions": [
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check Website Safety"
  }
}
